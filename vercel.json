{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo Proxy-only ETHAN LEARN deployment",
  "buildCommand": "node -e \"const fs=require('fs');fs.mkdirSync('proxy-out',{recursive:true});fs.writeFileSync('proxy-out/_proxy-placeholder.txt','ETHAN LEARN reverse proxy');\"",
  "outputDirectory": "proxy-out",
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "https://ethan-erp-lms.onrender.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
